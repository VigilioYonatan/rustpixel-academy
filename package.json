{
  "name": "rustpixel-academy",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx @biomejs/biome check src",
    "biome:check": "npx @biomejs/biome check src",
    "biome:write": "npx @biomejs/biome check --write src",
    "content:check": "node scripts/validate-content.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "senior:check": "node scripts/verify-senior.cjs",
    "senior:labs-check": "node scripts/check-senior-labs.mjs",
    "senior:cargo": "node scripts/senior-cargo-runner.mjs",
    "vigilio:check": "node scripts/check-vigilio-refs.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "senior:demo-check": "node scripts/test-incident-arena.cjs"
  },
  "dependencies": {
    "preact": "^10.26.0",
    "@preact/signals": "^2.2.0",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "codemirror": "^6.0.2",
    "lucide-preact": "^0.468.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.6",
    "vitest": "^3.1.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "playwright": "^1.51.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
